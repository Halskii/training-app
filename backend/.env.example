SUPABASE_URL=https://your-project.supabase.co
# Backend-only, bypasses RLS - never expose this to the Flutter client.
SUPABASE_SECRET_KEY=your-secret-key
# Client-safe key, used later by the Flutter app - not read by this backend,
# listed here so both keys live together for setup convenience.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ENVIRONMENT=development
